{
  "name": "waller",
  "version": "0.1.0",
  "description": "Multi-Monitor Wallpaper Manager for Windows built with Tauri, React, TypeScript and Bun.",
  "scripts": {
    "tauri": "tauri",
    "dev": "tauri dev",
    "web:dev": "vite --host localhost --port 3000 --strictPort",
    "web:build": "vite build",
    "web:preview": "vite preview --host localhost --port 4173",
    "build": "tauri build",
    "typecheck": "tsc --noEmit",
    "lint:frontend": "oxlint . --deny warnings",
    "lint:backend": "cd src-tauri && cargo clippy -- -D warnings",
    "format:backend": "cd src-tauri && cargo fmt --all",
    "format:backend:check": "cd src-tauri && cargo fmt --all --check",
    "check:rust": "cd src-tauri && cargo check",
    "test:rust": "cd src-tauri && cargo test --lib",
    "test:frontend": "vitest run --coverage",
    "deps:web:check": "bun outdated",
    "deps:web:update": "bun update --latest --force",
    "deps:rust:update": "cd src-tauri && cargo update",
    "deps:tauri:check": "node ./scripts/check-tauri-version-sync.mjs",
    "deps:update": "bun run deps:web:update && bun run deps:rust:update && bun run deps:tauri:check",
    "verify": "bun run deps:tauri:check && bun run typecheck && bun run lint:frontend && bun run test:frontend && bun run test:rust && bun run lint:backend && bun run check:rust && bun run web:build"
  },
  "keywords": [
    "wallpaper",
    "windows",
    "multi-monitor",
    "tauri",
    "desktop",
    "react",
    "typescript"
  ],
  "author": "Waller Contributors",
  "license": "MIT",
  "homepage": "https://github.com/gvastethecreator/waller#readme",
  "bugs": {
    "url": "https://github.com/gvastethecreator/waller/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gvastethecreator/waller.git"
  },
  "packageManager": "bun@1.3.14",
  "type": "module",
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@tauri-apps/cli": "^2.11.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-istanbul": "^4.1.7",
    "jsdom": "^29.1.1",
    "oxlint": "^1.66.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.14",
    "vitest": "^4.1.7"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-log": "^2.8.0",
    "gsap": "^3.15.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  }
}