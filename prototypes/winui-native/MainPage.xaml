<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="WallerWinUIPrototype.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:WallerWinUIPrototype"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:WallerWinUIPrototype.ViewModels"
    mc:Ignorable="d">

    <Grid Padding="24" RowSpacing="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="8">
            <TextBlock Text="Waller WinUI Native Prototype" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock
                Text="Throwaway shell for validating a native Windows migration. Actions are in-memory until the Windows API boundary is ported."
                TextWrapping="Wrap"
                Style="{StaticResource BodyTextBlockStyle}" />
        </StackPanel>

        <Grid Grid.Row="1" ColumnSpacing="18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="3*" />
            </Grid.ColumnDefinitions>

            <StackPanel Spacing="12">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Command="{x:Bind ViewModel.RefreshMockMonitorsCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE72C;" FontSize="14" />
                            <TextBlock Text="Refresh" />
                        </StackPanel>
                    </Button>
                    <Button Command="{x:Bind ViewModel.ApplyAllCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE73E;" FontSize="14" />
                            <TextBlock Text="Apply all" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <ListView
                    MinHeight="360"
                    ItemsSource="{x:Bind ViewModel.Monitors, Mode=OneWay}"
                    SelectedItem="{x:Bind ViewModel.SelectedMonitor, Mode=TwoWay}">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:MonitorDraft">
                            <Grid Padding="12" ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border
                                    Width="56"
                                    Height="38"
                                    CornerRadius="4"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                                    <FontIcon Glyph="&#xE7F4;" FontSize="18" />
                                </Border>
                                <StackPanel Grid.Column="1" Spacing="3">
                                    <TextBlock Text="{x:Bind Name}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <TextBlock Text="{x:Bind Geometry}" Style="{StaticResource CaptionTextBlockStyle}" />
                                    <TextBlock Text="{x:Bind ImagePath}" TextTrimming="CharacterEllipsis" Style="{StaticResource CaptionTextBlockStyle}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>

            <Grid Grid.Column="1" RowSpacing="14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Spacing="8">
                    <TextBlock Text="Selected Draft" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBox
                        Header="Wallpaper source"
                        Text="{x:Bind ViewModel.SelectedImagePath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBox
                        Header="Fit mode"
                        Text="{x:Bind ViewModel.SelectedFitMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
                    <Button Command="{x:Bind ViewModel.PickMockImageCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE8E5;" FontSize="14" />
                            <TextBlock Text="Pick mock image" />
                        </StackPanel>
                    </Button>
                    <Button Command="{x:Bind ViewModel.ClearSelectedCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE894;" FontSize="14" />
                            <TextBlock Text="Clear" />
                        </StackPanel>
                    </Button>
                    <Button Command="{x:Bind ViewModel.ApplySelectedCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE74E;" FontSize="14" />
                            <TextBlock Text="Apply selected" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel Grid.Row="2" Spacing="12">
                    <TextBox
                        Header="Profile name"
                        Text="{x:Bind ViewModel.ProfileName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <Button Command="{x:Bind ViewModel.SaveDraftProfileCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE74E;" FontSize="14" />
                            <TextBlock Text="Save draft in memory" />
                        </StackPanel>
                    </Button>
                    <TextBlock Text="State" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <TextBlock
                            FontFamily="Consolas"
                            Text="{x:Bind ViewModel.StateDump, Mode=OneWay}"
                            TextWrapping="Wrap" />
                    </ScrollViewer>
                </StackPanel>
            </Grid>
        </Grid>

        <InfoBar
            Grid.Row="2"
            IsOpen="True"
            Severity="Informational"
            Message="{x:Bind ViewModel.StatusText, Mode=OneWay}" />
    </Grid>
</Page>
