<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Waller.Native.App.Controls.MissingMonitorRow"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Waller.Native.App.Controls">

    <Grid
        Padding="0,6"
        ColumnSpacing="12"
        AutomationProperties.Name="{Binding Row.DisplayName, ElementName=Root}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="48" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <controls:SourcePreview
            PreviewWidth="48"
            PreviewHeight="30"
            PreviewTextFontSize="10"
            PreviewTextTrimming="CharacterEllipsis"
            PreviewTextWrapping="NoWrap"
            PreviewBrush="{Binding Row.SourcePreviewBrush, ElementName=Root}"
            PreviewImageBrush="{Binding Row.SourcePreviewImageBrush, ElementName=Root}"
            PreviewImageVisibility="{Binding Row.SourcePreviewImageVisibility, ElementName=Root}"
            PreviewText="{Binding Row.SourceSummary, ElementName=Root}"
            PreviewTextVisibility="{Binding Row.SourcePreviewTextVisibility, ElementName=Root}"
            AutomationProperties.Name="{Binding Row.SourceSummary, ElementName=Root}" />

        <StackPanel Grid.Column="1" Spacing="2">
            <TextBlock
                Text="{Binding Row.DisplayName, ElementName=Root}"
                TextTrimming="CharacterEllipsis"
                ToolTipService.ToolTip="{Binding Row.DisplayName, ElementName=Root}"
                Style="{StaticResource BodyStrongTextBlockStyle}" />
            <TextBlock
                Text="{Binding Row.Resolution, ElementName=Root}"
                TextTrimming="CharacterEllipsis"
                ToolTipService.ToolTip="{Binding Row.Resolution, ElementName=Root}"
                Style="{StaticResource CaptionTextBlockStyle}" />
            <TextBlock
                Text="{Binding Row.Bounds, ElementName=Root}"
                TextTrimming="CharacterEllipsis"
                ToolTipService.ToolTip="{Binding Row.Bounds, ElementName=Root}"
                Style="{StaticResource CaptionTextBlockStyle}" />
        </StackPanel>

        <StackPanel Grid.Column="2" Spacing="2" HorizontalAlignment="Right">
            <TextBlock
                MaxWidth="220"
                Text="{Binding Row.SourceSummary, ElementName=Root}"
                TextTrimming="CharacterEllipsis"
                ToolTipService.ToolTip="{Binding Row.SourceSummary, ElementName=Root}"
                Style="{StaticResource CaptionTextBlockStyle}" />
            <TextBlock
                MaxWidth="220"
                Text="{Binding Row.PlacementSummary, ElementName=Root}"
                TextTrimming="CharacterEllipsis"
                ToolTipService.ToolTip="{Binding Row.PlacementSummary, ElementName=Root}"
                Style="{StaticResource CaptionTextBlockStyle}" />
        </StackPanel>

        <Button
            Grid.Column="3"
            Width="40"
            Height="32"
            Padding="0"
            Command="{Binding ReassignCommand, ElementName=Root}"
            CommandParameter="{Binding Row, ElementName=Root}"
            AutomationProperties.AutomationId="MissingMonitorReassignButton"
            AutomationProperties.Name="{Binding Row.ReassignAccessibleName, ElementName=Root}"
            IsEnabled="{Binding CanEdit, ElementName=Root}"
            ToolTipService.ToolTip="{Binding ReassignText, ElementName=Root}">
            <FontIcon Glyph="&#xE8AB;" Style="{StaticResource WallerButtonIconStyle}" />
        </Button>
        <Button
            Grid.Column="4"
            Width="40"
            Height="32"
            Padding="0"
            Command="{Binding ForgetCommand, ElementName=Root}"
            CommandParameter="{Binding Row, ElementName=Root}"
            AutomationProperties.AutomationId="MissingMonitorForgetButton"
            AutomationProperties.Name="{Binding Row.ForgetAccessibleName, ElementName=Root}"
            IsEnabled="{Binding CanEdit, ElementName=Root}"
            ToolTipService.ToolTip="{Binding ForgetText, ElementName=Root}">
            <FontIcon Glyph="&#xE74D;" Style="{StaticResource WallerButtonIconStyle}" />
        </Button>
    </Grid>
</UserControl>
