<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Waller.Native.App.Controls.MonitorWorkspace"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Waller.Native.App.Controls"
    xmlns:vm="using:Waller.Native.App.ViewModels">

    <Grid ColumnSpacing="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="360" />
        </Grid.ColumnDefinitions>

        <ScrollViewer
            VerticalScrollBarVisibility="Auto"
            VerticalScrollMode="Auto">
            <StackPanel Spacing="10">
                <ListView
                    AutomationProperties.AutomationId="MonitorList"
                    AutomationProperties.Name="{Binding ViewModel.Text.EditMonitor, ElementName=Root}"
                    ItemsSource="{Binding ViewModel.Monitors, ElementName=Root}"
                    SelectedItem="{Binding ViewModel.SelectedMonitor, ElementName=Root, Mode=TwoWay}"
                    SelectionMode="Single">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:MonitorRowViewModel">
                            <controls:MonitorRow
                                Row="{Binding}"
                                EditCommand="{Binding ViewModel.SelectMonitorCommand, ElementName=Root}"
                                ApplyCommand="{Binding ViewModel.ApplyMonitorCommand, ElementName=Root}"
                                CanApply="{Binding ViewModel.CanStartApply, ElementName=Root}"
                                EditText="{Binding ViewModel.Text.Edit, ElementName=Root}"
                                ApplyText="{Binding ViewModel.Text.Apply, ElementName=Root}" />
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <Border
                    Padding="12"
                    CornerRadius="{ThemeResource OverlayCornerRadius}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    Visibility="{Binding ViewModel.MissingMonitorsVisibility, ElementName=Root}">
                    <StackPanel Spacing="8">
                        <StackPanel>
                            <TextBlock
                                Text="{Binding ViewModel.Text.MissingMonitors, ElementName=Root}"
                                Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock
                                Text="{Binding ViewModel.Text.MissingMonitorsSubtitle, ElementName=Root}"
                                Style="{StaticResource CaptionTextBlockStyle}" />
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding ViewModel.MissingMonitors, ElementName=Root}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:MissingMonitorRowViewModel">
                                    <controls:MissingMonitorRow
                                        Row="{Binding}"
                                        ReassignCommand="{Binding ViewModel.ReassignMissingMonitorCommand, ElementName=Root}"
                                        ForgetCommand="{Binding ViewModel.ForgetMissingMonitorCommand, ElementName=Root}"
                                        CanEdit="{Binding ViewModel.CanEditMonitorAssignment, ElementName=Root}"
                                        ReassignText="{Binding ViewModel.Text.Reassign, ElementName=Root}"
                                        ForgetText="{Binding ViewModel.Text.Forget, ElementName=Root}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <TextBlock
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Text="{Binding ViewModel.Text.NoMonitorsDetected, ElementName=Root}"
            Style="{StaticResource BodyTextBlockStyle}"
            Visibility="{Binding ViewModel.NoMonitorsVisibility, ElementName=Root}" />

        <controls:EditPanel
            Grid.Column="1"
            ViewModel="{Binding ViewModel, ElementName=Root}" />
    </Grid>
</UserControl>
