<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Waller.Native.App.Controls.MonitorWorkspace"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Waller.Native.App.Controls"
    xmlns:vm="using:Waller.Native.App.ViewModels">

    <Grid ColumnSpacing="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="224" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border
            Padding="12"
            CornerRadius="{ThemeResource OverlayCornerRadius}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
            <Grid RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                    <TextBlock
                        Margin="4,2,0,0"
                        Text="{Binding ViewModel.MonitorCountHeader, ElementName=Root}"
                        Style="{StaticResource SubtitleTextBlockStyle}" />

                    <Grid Grid.Row="1">
                        <ListView
                            x:Name="MonitorList"
                            AutomationProperties.AutomationId="MonitorList"
                            AutomationProperties.Name="{Binding ViewModel.Text.Monitors, ElementName=Root}"
                            ContainerContentChanging="OnMonitorListContainerContentChanging"
                            ItemsSource="{Binding ViewModel.Monitors, ElementName=Root}"
                            SelectedItem="{Binding ViewModel.SelectedMonitor, ElementName=Root, Mode=TwoWay}"
                            SelectionMode="Single">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="vm:MonitorRowViewModel">
                                    <Border
                                        Margin="0,0,0,8"
                                        Padding="8"
                                        CornerRadius="{ThemeResource ControlCornerRadius}"
                                        BorderBrush="{x:Bind TopologyBorderBrush, Mode=OneWay}"
                                        BorderThickness="{x:Bind TopologyBorderThickness, Mode=OneWay}"
                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        Opacity="{x:Bind TopologyOpacity, Mode=OneWay}">
                                        <StackPanel Spacing="7">
                                            <Grid Width="184" Height="88" HorizontalAlignment="Center">
                                                <controls:SourcePreview
                                                    AutomationProperties.Name="{x:Bind SourceSummary, Mode=OneWay}"
                                                    PreviewBadgeText="{x:Bind Session.Monitor.Identity.DisplayIndex, Mode=OneWay}"
                                                    PreviewBadgeVisibility="Visible"
                                                    PreviewWidth="184"
                                                    PreviewHeight="88"
                                                    PreviewBrush="{x:Bind SourcePreviewBrush, Mode=OneWay}"
                                                    PreviewImageBrush="{x:Bind SourcePreviewImageBrush, Mode=OneWay}"
                                                    PreviewImageVisibility="{x:Bind SourcePreviewImageVisibility, Mode=OneWay}"
                                                    PreviewText="{x:Bind SourceSummary, Mode=OneWay}"
                                                    PreviewTextVisibility="{x:Bind SourcePreviewTextVisibility, Mode=OneWay}"
                                                    PreviewTextTrimming="CharacterEllipsis"
                                                    PreviewTextWrapping="NoWrap" />
                                            </Grid>
                                            <TextBlock
                                                Text="{x:Bind DisplayName, Mode=OneWay}"
                                                TextWrapping="NoWrap"
                                                TextTrimming="CharacterEllipsis"
                                                Style="{StaticResource BodyStrongTextBlockStyle}" />
                                            <StackPanel Spacing="1">
                                                <TextBlock
                                                    Text="{x:Bind Resolution, Mode=OneWay}"
                                                    TextTrimming="CharacterEllipsis"
                                                    TextWrapping="NoWrap"
                                                    Style="{StaticResource CaptionTextBlockStyle}" />
                                                <TextBlock
                                                    Foreground="{ThemeResource WallerStatusSuccessBrush}"
                                                    Text="{x:Bind StatusSummary, Mode=OneWay}"
                                                    TextTrimming="CharacterEllipsis"
                                                    TextWrapping="NoWrap"
                                                    Style="{StaticResource CaptionTextBlockStyle}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Text="{Binding ViewModel.Text.NoMonitorsDetected, ElementName=Root}"
                            Style="{StaticResource BodyTextBlockStyle}"
                            Visibility="{Binding ViewModel.NoMonitorsVisibility, ElementName=Root}" />
                    </Grid>

                <StackPanel Grid.Row="2" Spacing="12">
                    <Border
                        Padding="8"
                        CornerRadius="{ThemeResource ControlCornerRadius}"
                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                        Visibility="{Binding ViewModel.MissingMonitorsVisibility, ElementName=Root}">
                        <StackPanel Spacing="4">
                            <TextBlock
                                Text="{Binding ViewModel.Text.MissingMonitors, ElementName=Root}"
                                Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <ItemsControl ItemsSource="{Binding ViewModel.MissingMonitors, ElementName=Root}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:MissingMonitorRowViewModel">
                                        <controls:MissingMonitorRow
                                            Row="{Binding}"
                                            ReassignCommand="{Binding ViewModel.ReassignMissingMonitorCommand, ElementName=Root}"
                                            ForgetCommand="{Binding ViewModel.ForgetMissingMonitorCommand, ElementName=Root}"
                                            CanEdit="{Binding ViewModel.CanEditMonitorAssignment, ElementName=Root}"
                                            ReassignText="{Binding ViewModel.Text.Reassign, ElementName=Root}"
                                            ForgetText="{Binding ViewModel.Text.Forget, ElementName=Root}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                    <Button
                        HorizontalAlignment="Stretch"
                        MinHeight="64"
                        Command="{Binding ViewModel.RefreshCommand, ElementName=Root}"
                        AutomationProperties.AutomationId="DetectMonitorsButton"
                        AutomationProperties.Name="{Binding ViewModel.Text.DetectMonitors, ElementName=Root}"
                        IsEnabled="{Binding ViewModel.CanStartApply, ElementName=Root}"
                        ToolTipService.ToolTip="{Binding ViewModel.Text.DetectMonitors, ElementName=Root}">
                        <controls:IconText Glyph="&#xE710;" Text="{Binding ViewModel.Text.DetectMonitors, ElementName=Root}" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Column="1" RowSpacing="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="301" />
            </Grid.RowDefinitions>

            <controls:TopologyStrip ViewModel="{Binding ViewModel, ElementName=Root}" />

            <ScrollViewer
                Grid.Row="1"
                Margin="16,0,16,16"
                VerticalScrollBarVisibility="Auto"
                VerticalScrollMode="Auto">
                <controls:EditPanel ViewModel="{Binding ViewModel, ElementName=Root}" />
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
