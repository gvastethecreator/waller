<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="Waller.Native.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Waller.Native.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <!-- Other merged dictionaries here -->
            </ResourceDictionary.MergedDictionaries>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="WallerModalOverlayBrush" Color="#80000000" />
                    <SolidColorBrush x:Key="WallerPrimaryBrush" Color="#FFFFB900" />
                    <SolidColorBrush x:Key="WallerPrimaryTextBrush" Color="#FF1F1F1F" />
                    <SolidColorBrush x:Key="WallerSelectionBrush" Color="#FF0078D4" />
                    <SolidColorBrush x:Key="WallerSelectionTextBrush" Color="#FFFFFFFF" />
                    <SolidColorBrush x:Key="WallerPreviewLabelBrush" Color="#CC111111" />
                    <SolidColorBrush x:Key="WallerPreviewLabelTextBrush" Color="#FFFFFFFF" />
                    <LinearGradientBrush x:Key="WallerStageBrush" StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#FF20242A" Offset="0" />
                        <GradientStop Color="#FF171C22" Offset="0.55" />
                        <GradientStop Color="#FF20242A" Offset="1" />
                    </LinearGradientBrush>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="WallerModalOverlayBrush" Color="#80000000" />
                    <SolidColorBrush x:Key="WallerPrimaryBrush" Color="#FFFFB900" />
                    <SolidColorBrush x:Key="WallerPrimaryTextBrush" Color="#FF1F1F1F" />
                    <SolidColorBrush x:Key="WallerSelectionBrush" Color="#FF0078D4" />
                    <SolidColorBrush x:Key="WallerSelectionTextBrush" Color="#FFFFFFFF" />
                    <SolidColorBrush x:Key="WallerPreviewLabelBrush" Color="#CC111111" />
                    <SolidColorBrush x:Key="WallerPreviewLabelTextBrush" Color="#FFFFFFFF" />
                    <LinearGradientBrush x:Key="WallerStageBrush" StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#FFF9FBFD" Offset="0" />
                        <GradientStop Color="#FFEEF5FB" Offset="0.55" />
                        <GradientStop Color="#FFF8FAFC" Offset="1" />
                    </LinearGradientBrush>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
            <Style x:Key="WallerButtonIconStyle" TargetType="FontIcon">
                <Setter Property="FontSize" Value="14" />
            </Style>
            <Style x:Key="WallerButtonContentStackStyle" TargetType="StackPanel">
                <Setter Property="Orientation" Value="Horizontal" />
                <Setter Property="Spacing" Value="6" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
